{
  "slug": "mcp-composer",
  "name": "Mcp Composer",
  "domain": "AI Platform / Agents",
  "target_user": "Domain operator, business owner, analyst, or team member who needs this workflow executed reliably.",
  "core_job": "MCP tools → composed agent workflows",
  "deep_features": [
    "tool registry",
    "permission model",
    "workflow builder",
    "prompt/tool templates",
    "dry-run simulator",
    "approval gates",
    "audit logs"
  ],
  "input_schema": [
    {
      "key": "mcp_tools",
      "label": "MCP tools",
      "type": "text",
      "required": true,
      "help": "Affects input: MCP tools.",
      "affects": [
        "prompt",
        "workflow"
      ],
      "default": ""
    },
    {
      "key": "work_brief",
      "label": "Work brief / source text / URL / instructions",
      "type": "textarea",
      "required": true,
      "default": "",
      "help": "Paste the material, URL, description, or instruction needed for this project.",
      "affects": [
        "prompt",
        "workflow"
      ]
    }
  ],
  "customization_schema": [
    {
      "key": "execution_mode",
      "label": "Execution mode",
      "type": "select",
      "required": false,
      "options": [
        "Draft",
        "Production",
        "Audit / strict review",
        "JSON/API output"
      ],
      "default": "Production",
      "help": "Controls strictness, depth, and output format for this project workflow.",
      "affects": [
        "workflow",
        "validation",
        "export"
      ]
    },
    {
      "key": "allowed_tools",
      "label": "allowed tools",
      "type": "text",
      "required": false,
      "help": "Affects customization: allowed tools.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "auth_scopes",
      "label": "auth scopes",
      "type": "text",
      "required": false,
      "help": "Affects customization: auth scopes.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "model_provider",
      "label": "model provider",
      "type": "select",
      "required": false,
      "help": "Affects customization: model provider.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "approval_rules",
      "label": "approval rules",
      "type": "textarea",
      "required": false,
      "help": "Affects customization: approval rules.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "workflow_limits",
      "label": "workflow limits",
      "type": "text",
      "required": false,
      "help": "Affects customization: workflow limits.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "tenant_policy",
      "label": "tenant policy",
      "type": "text",
      "required": false,
      "help": "Affects customization: tenant policy.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "output_format",
      "label": "output format",
      "type": "select",
      "required": false,
      "help": "Affects customization: output format.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "Markdown",
        "JSON",
        "CSV",
        "PDF",
        "DOCX",
        "XLSX"
      ],
      "default": "Markdown"
    },
    {
      "key": "language",
      "label": "language",
      "type": "select",
      "required": false,
      "help": "Affects customization: language.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "English",
        "Arabic",
        "Egyptian Arabic",
        "French",
        "German",
        "Spanish"
      ],
      "default": "English"
    },
    {
      "key": "privacy_mode",
      "label": "privacy mode",
      "type": "select",
      "required": false,
      "help": "Affects customization: privacy mode.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "cloud allowed",
        "local only",
        "redact sensitive data"
      ],
      "default": "cloud allowed"
    },
    {
      "key": "confidence_threshold",
      "label": "Confidence threshold",
      "type": "slider",
      "required": false,
      "min": 0,
      "max": 100,
      "default": 75,
      "help": "Items below this confidence are escalated to the human review queue.",
      "affects": [
        "validation",
        "workflow",
        "export"
      ]
    }
  ],
  "workflow_steps": [
    "MCP tools",
    "composed agent workflows"
  ],
  "ui_panels": [
    "tool catalog",
    "workflow canvas",
    "simulator",
